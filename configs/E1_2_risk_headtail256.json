{
  "name": "E1_2_risk_headtail256",
  "plan_id": "E1.2",
  "description": "M1/H1a: as R2 but risk max_len 256 with head+tail truncation (first 64 + last 190 tokens; Sun et al. 2019 Sec. 5.3.1). Validation only.",
  "model_name": "google/muril-base-cased",
  "tasks": [
    "sentiment",
    "emotion",
    "risk"
  ],
  "seeds": [
    13,
    21
  ],
  "evaluate_test": false,
  "save_checkpoint": false,
  "train": {
    "epochs": 3,
    "batch_size": 16,
    "encoder_lr": 3e-05,
    "head_lr": 0.0005,
    "warmup_ratio": 0.06,
    "weight_decay": 0.01,
    "patience": 2,
    "amp": true,
    "max_len": {
      "risk": 256
    },
    "truncation": {
      "risk": "head_tail"
    },
    "head_tokens": 64
  }
}
